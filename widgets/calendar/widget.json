  "sizes": ["small", "medium", "large"],
  "interval": 30,
  "color_accent": "red",
  "uses": ["events"],
  "options": [
    {"key": "week_numbers", "type": "bool", "default": true, "label": {"uk": "Номер тижня", "en": "Week number"}}
  ]
}

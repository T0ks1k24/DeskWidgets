{
  "id": "calendar",
  "version": "2.0",
  "author": "DeskWidgets",
  "category": "time",
  "name": {"uk": "Календар", "en": "Calendar"},
  "description": {"uk": "Сьогодні, тиждень або цілий місяць; дні з подіями позначені крапкою",

#!/usr/bin/env python3
"""Start DeskWidgets from a source checkout without installing it (an installed copy has its own `deskwidgets`)."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..'))

from deskwidgets.cli import main  # noqa: E402

sys.exit(main())

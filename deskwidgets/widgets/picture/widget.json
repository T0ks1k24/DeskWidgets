     "hint": {"uk": "PNG, JPG, WebP…", "en": "PNG, JPG, WebP…"}},
    {"key": "caption", "type": "text", "default": "", "label": {"uk": "Підпис", "en": "Caption"}},
    {"key": "fit", "type": "choice", "default": "cover", "label": {"uk": "Як вписати", "en": "Fit"},
     "choices": [
       {"value": "cover", "label": {"uk": "Заповнити картку", "en": "Fill the card"}},
       {"value": "contain", "label": {"uk": "Показати повністю", "en": "Show it all"}}
     ]}
  ]
}

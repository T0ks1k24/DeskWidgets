{
  "id": "picture",
  "version": "1.0",
  "author": "DeskWidgets",
  "category": "personal",
  "name": {"uk": "Картинка", "en": "Picture"},
  "description": {"uk": "Ваш арт, фото чи улюблений персонаж на робочому столі",
                  "en": "Your art, a photo or a favourite character on the desktop"},
  "sizes": ["small", "medium", "large"],
  "interval": 60,
  "color_accent": "purple",
